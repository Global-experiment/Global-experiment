# Every environment variable of the project, documented. No real values here — ever.
#
# Local development: you don't copy this file. Run `npm run setup`: it writes .env.local
# (gitignored) with the few values a machine needs, generates its secrets, and prepares a local
# database. Everything else below is optional locally and has a safe default.
# Production uses the server's own environment, never a file from the repository.
#
# Legend:  [setup] written by npm run setup · [optional] leave unset locally · [prod] production only
# The Next.js app, the API (apps/api) and drizzle-kit all read the one repo-root .env.local.
# Never put a secret behind a NEXT_PUBLIC_ prefix: those values are sent to every browser.

# ---------------------------------------------------------------------------
# Local development (written by npm run setup)
# ---------------------------------------------------------------------------

# [setup] The database. Locally: pglite:<folder> — PostgreSQL in a folder, nothing to install
# (refused in production). Or a PostgreSQL server on this machine whose database ends in _dev, e.g.
# postgres://you@localhost:5432/global_experiment_dev. Production: the server's PostgreSQL.
DATABASE_URL=pglite:.data/pglite

# [setup] Shared secret between the API and the site for on-demand page refresh (32+ characters).
# npm run setup generates one per machine. Optional locally (pages then refresh on their own).
REVALIDATE_SECRET=

# [setup] The local Rootadmin npm run setup creates (this machine only, never production).
LOCAL_ADMIN_EMAIL=rootadmin@example.com
LOCAL_ADMIN_PASSWORD=

# [setup] Private preview link of the donate page: /donate?preview=<token> (32–128 of A-Z a-z 0-9 _ -).
DONATIONS_PREVIEW_TOKEN=

# ---------------------------------------------------------------------------
# Public site content (Notion) — optional locally
# ---------------------------------------------------------------------------

# [optional] Home and Documentation are read live from Notion. Without these three values, locally,
# those pages say "Notion isn't connected in this local setup" (no content); everything else works.
# Production requires all three. Ask the maintainer for read access if you work on these pages.
NOTION_API_KEY=
NOTION_DOCUMENTATION_DB_ID=
NOTION_HOME_PAGE_ID=

# ---------------------------------------------------------------------------
# How the site reaches the API
# ---------------------------------------------------------------------------

# [optional] Where the Next.js server sends /api/admin, /api/donations, /api/stripe and
# /api/treasury. Default http://127.0.0.1:4000 (the API of npm run dev:local).
ADMIN_API_ORIGIN=
# [optional] Where the API reaches the Next.js server for page refresh. Default http://127.0.0.1:3000.
WEB_INTERNAL_URL=
# [optional] The public site's address (donation return links, the donate origin check).
# Default http://localhost:3000.
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# API (apps/api) — all optional locally
# ---------------------------------------------------------------------------

# [optional] development (default) | test | production. Leave unset locally.
NODE_ENV=
# [optional] Where the API listens. Defaults 127.0.0.1 and 4000.
API_HOST=
API_PORT=
# [optional] fatal | error | warn | info | debug | trace | silent. Default debug locally, info in production.
LOG_LEVEL=
# [prod] Origins allowed to make admin changes (CSRF check), comma-separated, e.g.
# https://globalexperiment.org. Default locally: http://localhost:3000 and http://localhost:3100.
ADMIN_ALLOWED_ORIGINS=
# [optional] Admin session lifetime. Defaults 480 idle minutes, 7 days at most.
ADMIN_SESSION_IDLE_MINUTES=
ADMIN_SESSION_MAX_DAYS=
# [prod] Reverse-proxy hops to trust for the client IP. Default 0 (1 behind one proxy).
TRUST_PROXY_HOPS=
# [optional] Secure session cookie. Default false locally (http), always true in production.
COOKIE_SECURE=
# [optional] Treasury supporting documents. Default .data/files locally (gitignored).
FILE_STORAGE_DIR=
# [optional] Background jobs: pgboss (a PostgreSQL server) or inprocess. Default inprocess with
# pglite:, pgboss otherwise.
JOBS_DRIVER=

# ---------------------------------------------------------------------------
# Donations (Stripe) — optional locally
# ---------------------------------------------------------------------------

# [optional] Without a key, the donate page says "Donations are unavailable" locally; the rest works.
# To work on donations, use YOUR OWN Stripe account's TEST keys (sk_test_… / pk_test_…), never the
# project's. A live key is refused unless STRIPE_LIVE_ENABLED=true (production only).
# See docs/operations/stripe.md.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# [optional] Printed by `stripe listen` when you forward test webhooks to your machine.
STRIPE_WEBHOOK_SECRET=
# [prod] true only on the server, with the live key.
STRIPE_LIVE_ENABLED=
# [optional] Customer-portal login link (https), offered while monthly donations are on.
STRIPE_CUSTOMER_PORTAL_URL=
# [optional] Late-fee fill-in interval in minutes. Default 15; 0 turns it off.
STRIPE_FEE_RECONCILE_MINUTES=

# Donation settings: environment defaults (an admin setting overrides them). All default false
# except DONATIONS_DEFAULT_CURRENCY (USD) and DONATIONS_CHECKOUT (hosted).
DONATIONS_ENABLED=
DONATIONS_MONTHLY=
DONATIONS_EXTRA_METHODS=
# USD | EUR | CHF
DONATIONS_DEFAULT_CURRENCY=
DONATIONS_PAYPAL_MONTHLY=
# embedded (card fields on the page; needs STRIPE_PUBLISHABLE_KEY) | hosted (Stripe Checkout)
DONATIONS_CHECKOUT=

# ---------------------------------------------------------------------------
# Treasury — environment defaults of its settings, all optional (default false)
# ---------------------------------------------------------------------------

TREASURY_PUBLIC_RECIPIENT_NAMES=
TREASURY_PUBLISH_UNQUALIFIED=
TREASURY_WISE_CONNECTED=
TREASURY_DONATION_APPEAL=
TREASURY_SHOW_TEST_DONATIONS=
TREASURY_PUBLIC_TOOLBAR=
# USD (default) | EUR | CHF
TREASURY_STATS_CURRENCY=

# ---------------------------------------------------------------------------
# Tests — optional
# ---------------------------------------------------------------------------

# [optional] A PostgreSQL 17 database on this machine whose name ends in _test, wiped by the tests:
# npm run api:test:pg and the admin browser tests (npm run test:e2e) use it. Without it, the API
# tests run on PGlite and the browser tests skip the admin suites.
TEST_DATABASE_URL=
# [optional] Ports of the browser tests' servers. Defaults 3000 and 4100.
E2E_PORT=
E2E_API_PORT=

# ---------------------------------------------------------------------------
# Not used by the application
# ---------------------------------------------------------------------------

# [optional] Personal token for one-off Figma inspection scripts only.
FIGMA_ACCESS_TOKEN=

# Not built yet: AI and email (OPS-115). Their variables will be added here, optional locally.
