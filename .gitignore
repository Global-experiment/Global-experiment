# dependencies (root and npm workspaces)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build
# NestJS API build output
/apps/*/dist/

# misc
.DS_Store
# keys and certificates (never committed)
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# database dumps and backups (never committed)
*.dump
*.sql.gz
*.backup
/backups/
# private notes and files (never committed)
/private/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: every .env* file, except the documented example (no values)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only project reference sources (Figma exports, Notion exports, IA boards, etc.)
# Never commit real design/CMS exports without explicit approval.
.local/

# local editor and assistant settings (per developer, not project source)
.claude/
CLAUDE.md

# client design reference (local only — never commit design exports without approval)
/figma.pdf
/design.pdf
/docs/design/

# local file storage (FILE_STORAGE_DIR default outside production: Treasury supporting documents)
.data/
