{
  "name": "global-experiment",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "api:dev": "npm run dev -w @global-experiment/api",
    "api:build": "npm run build -w @global-experiment/api",
    "api:test": "npm run test -w @global-experiment/api",
    "api:test:pg": "npm run test:pg -w @global-experiment/api",
    "api:typecheck": "npm run typecheck -w @global-experiment/api"
  },
  "dependencies": {
    "@next/env": "^16.3.5",
    "@notionhq/client": "^5.26.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
