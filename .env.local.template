# Fill in real values here, then rename to .env.local (already gitignored).
# Do not paste these values into chat or commit this file once renamed.
# In development the Next.js app, the NestJS API (apps/api) and drizzle-kit
# all read this one repo-root .env.local. Production uses real environment
# variables only — never a file in the repository.

# --- Next.js public site: editorial content, validated in src/shared/config/env.ts ---
# The site reads editorial content live from Notion and has no
# fixture/placeholder fallback: all three Notion values are required, and a
# missing one is a clear runtime error (not silent stand-in content).
NOTION_API_KEY=
NOTION_DOCUMENTATION_DB_ID=
# ID of the Home page in Notion (share it with the integration).
NOTION_HOME_PAGE_ID=

# Where the Next.js server proxies same-origin /api/admin/*, /api/donations/*,
# /api/stripe/* and /api/treasury/* (the native API), and where its server
# components read the public donation routes. Defaults to http://127.0.0.1:4000
# in development (see src/shared/config/adminApi.ts and publicApi.ts).
ADMIN_API_ORIGIN=

# --- Native API (apps/api), validated at startup in apps/api/src/common/config/env.ts ---
# PostgreSQL connection string. Only the API and drizzle-kit use it; the
# Next.js app never connects to the database directly.
DATABASE_URL=
# Where the API listens (defaults: 127.0.0.1:4000).
API_HOST=
API_PORT=
# Comma-separated origins allowed to make state-changing admin requests
# (CSRF check). Required in production, e.g. https://globalexperiment.org
ADMIN_ALLOWED_ORIGINS=
# Admin session lifetime (defaults: 480 idle minutes, 7 days absolute).
ADMIN_SESSION_IDLE_MINUTES=
ADMIN_SESSION_MAX_DAYS=
# Reverse-proxy hops to trust for the client IP (default 0; 1 behind one proxy).
TRUST_PROXY_HOPS=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# --- Notion "0.1 native" importer (npm run api:import:taxonomy, apps/api) ---
# Database IDs of the 0.1 native workspace. The importer authenticates with
# NOTION_API_KEY above, so that integration must be shared with these
# databases (read-only is enough) — and with the Documentation database and
# Home page as long as the public site reads them with the same key.
NOTION_DOMAINS_DB_ID=
NOTION_FIELDS_DB_ID=
NOTION_EXPERTISE_DB_ID=
# npm run api:import:directory
NOTION_PEOPLE_DB_ID=
NOTION_ORGANIZATIONS_DB_ID=
# npm run api:import:treasury (expenses; donations come from Stripe)
NOTION_TREASURY_DB_ID=
# Not read by any importer yet; listed so every 0.1 native database has a name.
NOTION_FEEDBACK_DB_ID=
NOTION_SERVICES_DB_ID=
NOTION_ACCESS_GRANTS_DB_ID=

# --- Used only for one-off local tooling (e.g. Figma inspection scripts) ---
# --- Not read by the application itself ---
FIGMA_ACCESS_TOKEN=

# --- Donations (Stripe), apps/api — see docs/operations/stripe.md ---
# TEST keys locally (sk_test_…). A live key is refused unless
# STRIPE_LIVE_ENABLED=true. The publishable key isn't read by the app
# (Checkout is hosted by Stripe); keep it here only for reference.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Locally: printed by `stripe listen` (never commit it).
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=
# Customer-portal login link (https), offered while monthly donations are on.
STRIPE_CUSTOMER_PORTAL_URL=
# Late-fee fill-in interval in minutes (default 15; 0 turns it off).
STRIPE_FEE_RECONCILE_MINUTES=
# The public site's origin: Checkout return links and the donate origin check
# (default http://localhost:3000).
PUBLIC_SITE_URL=
# Where the API reaches the Next.js server for on-demand revalidation
# (default http://127.0.0.1:3000), and the shared secret both sides check
# (at least 32 characters; read by the API and by src/app/api/revalidate).
WEB_INTERNAL_URL=
REVALIDATE_SECRET=
# Environment defaults of the donation settings (a settings row overrides them).
# DONATIONS_ENABLED (default false): until true, /donate says "Donations open soon".
DONATIONS_ENABLED=
# Private preview link /donate?preview=<token> (32–128 of A-Z a-z 0-9 _ -).
DONATIONS_PREVIEW_TOKEN=
DONATIONS_MONTHLY=
DONATIONS_EXTRA_METHODS=
DONATIONS_DEFAULT_CURRENCY=

# --- Treasury (module 1b), apps/api: environment defaults of the settings (default false) ---
# Recipient names on public pages; unqualified expenses publishable ("Not qualified yet");
# Balance and Sustainability (Wise connected); the "Cry for donation" banner;
# production before go-live: Stripe sandbox donations public, marked Test (ignored with a live key).
TREASURY_PUBLIC_RECIPIENT_NAMES=
TREASURY_PUBLISH_UNQUALIFIED=
TREASURY_WISE_CONNECTED=
TREASURY_DONATION_APPEAL=
TREASURY_SHOW_TEST_DONATIONS=
# Scheduled Notion imports: a cron in UTC ("0 3 * * *") or off (default).
IMPORT_SCHEDULE_TAXONOMY=
IMPORT_SCHEDULE_DIRECTORY=
IMPORT_SCHEDULE_TREASURY=
# Supporting documents: private directory (default .data/files; production /var/lib/global-experiment/files).
FILE_STORAGE_DIR=
# Background jobs: pgboss (default; its own pgboss schema) or inprocess (tests).
JOBS_DRIVER=

# Later phases add their own variables here (names only), e.g. Wise,
# OpenAI, email — see docs/native-backend-implementation-plan.md. Never
# expose any of them through a NEXT_PUBLIC_ prefix.
