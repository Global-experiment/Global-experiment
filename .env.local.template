# Fill in real values here, then rename to .env.local (already gitignored).
# Do not paste these values into chat or commit this file once renamed.
# In development the Next.js app, the NestJS API (apps/api) and drizzle-kit
# all read this one repo-root .env.local. Production uses real environment
# variables only — never a file in the repository.

# --- Next.js public site: editorial content, validated in src/shared/config/env.ts ---
# The site reads editorial content live from Notion and has no
# fixture/placeholder fallback: all three Notion values are required, and a
# missing one is a clear runtime error (not silent stand-in content).
NOTION_API_KEY=
NOTION_DOCUMENTATION_DB_ID=
# ID of the Home page in Notion (share it with the integration).
NOTION_HOME_PAGE_ID=

# --- Native API (apps/api), validated at startup in apps/api/src/common/config/env.ts ---
# PostgreSQL connection string. Only the API and drizzle-kit use it; the
# Next.js app never connects to the database directly.
DATABASE_URL=
# Where the API listens (defaults: 127.0.0.1:4000).
API_HOST=
API_PORT=
# Comma-separated origins allowed to make state-changing admin requests
# (CSRF check). Required in production, e.g. https://globalexperiment.org
ADMIN_ALLOWED_ORIGINS=
# Admin session lifetime (defaults: 480 idle minutes, 7 days absolute).
ADMIN_SESSION_IDLE_MINUTES=
ADMIN_SESSION_MAX_DAYS=
# Reverse-proxy hops to trust for the client IP (default 0; 1 behind one proxy).
TRUST_PROXY_HOPS=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# --- Used only for one-off local tooling (e.g. Figma inspection scripts) ---
# --- Not read by the application itself ---
FIGMA_ACCESS_TOKEN=

# Later phases add their own variables here (names only), e.g. Stripe, Wise,
# OpenAI, email — see docs/native-backend-implementation-plan.md. Never
# expose any of them through a NEXT_PUBLIC_ prefix.
