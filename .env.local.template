# Fill in real values here, then rename to .env.local (already gitignored).
# Do not paste these values into chat or commit this file once renamed.

# --- Application config, validated at runtime via src/shared/config/env.ts ---
# The application reads editorial content live from Notion and has no
# fixture/placeholder fallback: all three Notion values are required, and a
# missing one is a clear runtime error (not silent stand-in content).
NOTION_API_KEY=
NOTION_DOCUMENTATION_DB_ID=
# ID of the Home page in Notion (share it with the integration).
NOTION_HOME_PAGE_ID=
# Not used by v0.1 (no Postgres in M1); leave empty until a later milestone.
DATABASE_URL=

# --- Used only for one-off local tooling (e.g. Figma inspection scripts) ---
# --- Not read by the application itself ---
FIGMA_ACCESS_TOKEN=

# Additional Notion database IDs (Treasury, Feedback/Issues, Contractors,
# Contributors) are added here when their milestone (M2/M3) begins.
#
# NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY are intentionally not
# listed: v0.1 accesses Postgres directly via DATABASE_URL and does not use
# the Supabase SDK or Supabase Auth (see docs/architecture/decisions/
# 002-postgresql-supabase-infrastructure.md). Add them only if a concrete
# future requirement needs Supabase-specific APIs.
